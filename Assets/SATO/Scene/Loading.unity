      \u30AF\u30E2\u306E\u7CF8\u3067\u30EA\u30D5\u30C8\u306E\u69D8\u306B\u4E0A\u4E0B\u306B\u904B\u3076\u3088\uFF01"
    image: {fileID: -7988949386458191243, guid: 070288ea4f4459b469080a4e5b554ec5, type: 3}
  - type: 5
    description: "\u4E00\u5EA6\u89E6\u308C\u308B\u3068\u3044\u306A\u304F\u306A\u308B
      \u7DBF\u306E\u3088\u3046\u306A\u4F53\u3092\u98DB\u3070\u3057\u3066\u305D\u306E\u5834\u304B\u3089\u96E2\u308C\u308B\u3088\uFF01"
    image: {fileID: 7231249935562880171, guid: acc7a89387b825a47bebdeac26e15ae9, type: 3}
  - type: 2
    description: "\u524D\u65B9\u306B\u3042\u308B\u540C\u3058\u9AD8\u3055\u306E\u8DB3\u5834\u307E\u3067\u904B\u3076(\u4F4D\u7F6E\u306E\u30EA\u30BB\u30C3\u30C8\u7121\u3057)
      \u8DB3\u306B\u3076\u3089\u4E0B\u3052\u3066\u5927\u304D\u306A\u7FBD\u3067\u5BFE\u5CB8\u307E\u3067\u6E21\u308B\u3088\uFF01"
    image: {fileID: -8845292621074354359, guid: 143e9e3bda835fb4e9a6c11692431901, type: 3}
  - type: 4
    description: "\u540C\u3058\u8272\u306E\u5BDD\u3053\u308D\u3093\u3060\u4E80\u306E\u5834\u6240\u306B\u79FB\u52D5\u3059\u308B(\u4E00\u65B9\u901A\u884C)
