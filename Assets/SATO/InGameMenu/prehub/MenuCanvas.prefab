  m_Script: {fileID: 11500000, guid: 379bbeadf62f780449584d3cbac6f043, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BookEncyclopediaUI
  pages:
  - animalName: "\u30B9\u30D7\u30EA\u30F3\u30CD\u30BA\u30DF"
    illustration: {fileID: -3810636262988332874, guid: f36cee8173aea5446a81134f70f5cb07, type: 3}
    unlockStageNumber: 1
    descriptionBox1: "\u7E41\u6B96\u80FD\u529B\u304C\u9AD8\u304F\u6D1E\u7A9F\u5916\u3067\u3082\u898B\u304B\u3051\u308B\u3053\u3068\u304C\u3042\u308A\u3001\u4E3B\u306A\u751F\u606F\u5730\u306F\u6697\u304F\u51B7\u305F\u3044\u6240\u3067\u306F\u3042\u308B\u304C\u307B\u3068\u3093\u3069\u306E\u74B0\u5883\u306B\u9069\u5FDC\u51FA\u6765\u308B\u3002"
    descriptionBox2: "\u80CC\u4E2D\u306E\u30D0\u30CD\u306B\u306F\u591A\u7A2E\u591A\u69D8\u306A\u7528\u9014\u304C\u3042\u308A\u5B50\u4F9B\u306E\u9803\u306F\u5B50\u4F9B\u540C\u58EB\u3067\u8DF3\u306D\u5408\u3044\u30B1\u30AC\u3092\u3059\u308B\u3053\u3068\u3042\u308B\u3068\u304B\u3002"
    descriptionBox3: "\u80CC\u4E2D\u306E\u30D0\u30CD\u3092\u8E0F\u3080\u3068\u524D\u65B9\u306B\u30B8\u30E3\u30F3\u30D7\u3059\u308B\u3053\u3068\u304C\u51FA\u6765\u308B\u3002"
  - animalName: "\u30A6\u30DF\u30DA\u30F3\u30C6\u30B9"
    illustration: {fileID: 8995348970283179234, guid: f36cee8173aea5446a81134f70f5cb07, type: 3}
    unlockStageNumber: 2
    descriptionBox1: "\u30A6\u30DF\u30D8\u30D3\u306F\u81C6\u75C5\u3067\u3042\u308A\u3001\u3053\u3061\u3089\u304B\u3089\u523A\u6FC0\u3092\u52A0\u3048\u305F\u308A\u3057\u306A\u3051\u308C\u3070\u57FA\u672C\u7684\u306B\u7121\u5BB3\u3067\u3042\u308B\u70BA\u8EAB\u3092\u4EFB\u305B\u308B\u3068\u826F\u3044\u3060\u308D\u3046\u3002"
    descriptionBox2: "\u307E\u305F\u3001\u76EE\u304C\u3042\u307E\u308A\u826F\u304F\u306A\u3044\u4EE3\u308F\u308A\u306B\u8033\u304C\u7570\u5E38\u306A\u7A0B\u3088\u304F\u3069\u308C\u3060\u3051\u97F3\u3092\u6BBA\u3057\u3066\u884C\u52D5\u3057\u3066\u3082\u6C17\u304C\u4ED8\u304B\u308C\u308B\u305E"
    descriptionBox3: "\u86C7\u306B\u89E6\u308C\u308B\u3053\u3068\u3067\u65B9\u5411\u3092\u53CD\u8EE2\u3059\u308B\u3053\u3068\u304C\u51FA\u6765\u308B\u3002"
  - animalName: "\u30A2\u30E9\u30AF\u30B1\u30A4\u30D6"
    illustration: {fileID: 4541673031453506266, guid: f36cee8173aea5446a81134f70f5cb07, type: 3}
    unlockStageNumber: 3
    descriptionBox1: "\u30AF\u30E2\u306F\u5929\u4E95\u304B\u3089\u52D5\u304F\u3053\u3068\u304C\u307B\u307C\u306A\u304F\u4E0B\u3078\u964D\u308A\u308B\u6642\u3082\u7CF8\u306E\u4F38\u3070\u3057\u51FA\u6765\u308B\u3060\u3051\u3059\u3050\u5929\u4E95\u3078\u3068\u623B\u308C\u308B\u3088\u3046\u306B\u3057\u3066\u3044\u308B\u3002"
    descriptionBox2: "\u307E\u305F\u305D\u306E\u7CF8\u306F\u7F60\u3068\u3057\u3066\u3082\u6A5F\u80FD\u3059\u308B\u305F\u3081\u6020\u3051\u8005\u306E\u5DE3\u307B\u3069\u653B\u7565\u304C\u96E3\u3057\u304F\u306A\u308B\u3068\u304B\u3002"
    descriptionBox3: "\u7CF8\u306B\u4E57\u308B\u3068\u305D\u3053\u304B\u3089\u4E00\u756A\u8FD1\u3044\u5834\u6240\u3078\u3068\u4E0A\u4E0B\u306B\u79FB\u52D5\u3059\u308B\u3053\u3068\u304C\u51FA\u6765\u308B\u3002"
  - animalName: "\u30B4\u30B7\u30D4\u30A6\u30E0"
    illustration: {fileID: -1442354706068789757, guid: ef332ca8c432ba64c81d62f09602d799, type: 3}
    unlockStageNumber: 4
    descriptionBox1: "\u304D\u308C\u3044\u306B\u54B2\u3044\u305F\u7DBF\u306F\u4EBA\u304C\u307B\u3093\u306E\u5C11\u3057\u4E57\u3063\u305F\u3060\u3051\u3067\u306F\u3059\u3050\u306B\u306F\u5D29\u308C\u306A\u3044\u8010\u4E45\u5EA6\u3068\u306A\u308B\u3002"
    descriptionBox2: "\u4E00\u5EA6\u5D29\u308C\u305F\u7DBF\u304C\u5B8C\u5168\u306B\u54B2\u304F\u306B\u306F\u3055\u307B\u3069\u639B\u304B\u3089\u306A\u3044\u304C\u4E7E\u71E5\u3057\u3066\u3057\u307E\u3046\u3068\u54B2\u304F\u30B9\u30D4\u30FC\u30C9\u304C\u9045\u304F\u306A\u3063\u3066\u3057\u307E\u3046\u3002"
    descriptionBox3: "\u7DBF\u306F\u4E00\u5EA6\u6E21\u308B\u3068\u5D29\u308C\u3066\u3057\u307E\u3046\u306E\u3067\u8981\u6CE8\u610F\u3002"
  - animalName: "\u30A6\u30A3\u30F3\u30B0\u30CF\u30C3\u30C8"
    illustration: {fileID: 4019803781210535998, guid: ef332ca8c432ba64c81d62f09602d799, type: 3}
    unlockStageNumber: 5
    descriptionBox1: "\u307B\u307C\u98DB\u3079\u306A\u3044\u3082\u306E\u306E\u81EA\u529B\u3067\u98DB\u3076\u3053\u3068\u304C\u51FA\u6765\u308B\u3002"
    descriptionBox2: "\u81EA\u5206\u3088\u308A\u3082\u5C0F\u3055\u306A\u7269\u306A\u3089\u3070\u91CD\u3055\u95A2\u4FC2\u306A\u304F\u98A8\u3092\u5229\u7528\u3057\u76F4\u7DDA\u306B\u98DB\u3076\u3053\u3068\u304C\u51FA\u6765\u308B\u3002"
    descriptionBox3: "\u89E6\u308C\u305F\u8005\u306F\u30A6\u30A3\u30F3\u30B0\u30CF\u30C3\u30C8\u306B\u3088\u3063\u3066\u524D\u65B9\u306E\u5E8A\u306B\u7740\u304F\u307E\u3067\u904B\u3093\u3067\u304F\u308C\u308B\u3002"
  - animalName: "\u30AA\u30D1\u30FC\u30EB\u30AC\u30E1"
    illustration: {fileID: 7671951352480112521, guid: ef332ca8c432ba64c81d62f09602d799, type: 3}
    unlockStageNumber: 6
    descriptionBox1: "\u7532\u7F85\u306E\u30AF\u30EA\u30B9\u30BF\u30EB\u306E\u8272\u306F\u9577\u304F\u89E6\u308C\u305F\u30AF\u30EA\u30B9\u30BF\u30EB\u3078\u3068\u306A\u308B\u3002"
    descriptionBox2: "\u4ED6\u306E\u8272\u306E\u30AF\u30EA\u30B9\u30BF\u30EB\u306E\u4E80\u3092\u6575\u5BFE\u8996\u3057\u3066\u3044\u308B\u3068\u304B\u3002"
    descriptionBox3: "\u4E80\u306E\u89E6\u308C\u308B\u3068\u540C\u8272\u306E\u5225\u306E\u4E80\u306B\u30EF\u30FC\u30D7\u3057\u3066\u3057\u307E\u3046\u3002"
